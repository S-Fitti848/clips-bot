# Copiar a .env y completar. Nunca commitear .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Gemini (paso 7). La misma key que usa el trading agent.
GEMINI_API_KEY=
# Segunda clave (opcional): solo se usa cuando la principal se queda sin la cuota del día.
GEMINI_API_KEY_2=
# Facebook (Reels de Pequeña Historia): ver docs/facebook.md. El token es el de la PÁGINA, de larga duración.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Bot de Telegram NUEVO (no el del trading). El chat id sale de getUpdates:
#   mandale cualquier mensaje al bot y corré  python -m clips_bot telegram-chat-id
# En un GRUPO el id es NEGATIVO (ej. -1001234567890), y con el modo privacidad de BotFather puesto
# (el default) el bot solo ve los mensajes que arrancan con / o que lo mencionan: mandá /start ahí.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Quiénes pueden mandarle comandos (/reclamo). Ids de USUARIO separados por coma; los lista
# `telegram-chat-id`. En un grupo el chat es uno solo y cualquier miembro podría excluir un
# streamer, por eso el permiso es por usuario. VACÍO = no se obedece ningún comando.
TELEGRAM_ALLOWED_USERS=
# Contacto para el User-Agent de Wikipedia/Commons (política de Wikimedia: nombre del bot + contacto).
# Lo ve Wikimedia en cada pedido; sin él va solo el link al repo.
WIKIMEDIA_CONTACTO=
# API key de YouTube Data API v3 (Google Cloud → Credenciales → Crear credenciales → Clave de API).
# La usa pego.py para buscar Shorts de otros canales (100 unidades por búsqueda). Sin ella, yt-dlp.
YOUTUBE_API_KEY=
